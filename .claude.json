{
  "mcpServers": {
    "semble": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]@latest",
        "semble",
        "--content",
        "all"
      ],
      "autoApprove": [
        "search",
        "find_related"
      ],
      "auto_approve": true
    },
    "aislop": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "-p",
        "aislop@latest",
        "aislop-mcp"
      ],
      "autoApprove": [
        "aislop_scan",
        "aislop_fix",
        "aislop_why",
        "aislop_baseline"
      ],
      "auto_approve": true
    },
    "konoha": {
      "type": "stdio",
      "command": "node",
      "args": [
        "src/file_tools_mcp.js"
      ],
      "env": {
        "ACTIVE_CLIENT": "cursor",
        "KONOHA_CLIENT": "cursor",
        "KONOHA_SEMANTIC_SEARCH": "1"
      },
      "autoApprove": [
        "read_file_head",
        "read_file_range",
        "file_info",
        "token_efficient_grep",
        "get_file_structure",
        "find_files_clean",
        "website_ai_detector",
        "docs_ai_detector",
        "get_resolved_task_dir",
        "find_skill",
        "list_skills",
        "get_skill",
        "optimize_report",
        "build_from_source",
        "build_from_text",
        "sannin",
        "kage",
        "jonin",
        "anbu",
        "chunin",
        "tokubetsu_jonin",
        "genin",
        "akatsuki",
        "report_from_agent",
        "get_project_context",
        "save_project_context",
        "query_project_memory",
        "web_search",
        "migrate_skills",
        "save_persona_memory",
        "query_persona_memory",
        "list_persona_memories",
        "delete_persona_memory",
        "check_readiness",
        "get_task_evidence",
        "get_slop_findings",
        "qa_codify",
        "qa_e2e_run"
      ],
      "auto_approve": true
    }
  },
  "autoApprove": [
