{
  "_comment": "Merge the mcpServers block into ~/.claude.json (global user config). Konoha init does this automatically when the claude CLI is installed.",
  "mcpServers": {
    "skills-db": {
      "type": "stdio",
      "command": "python3",
      "args": ["${HOME}/.gemini/skills-db/server.py"]
    },
    "semble": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "semble[mcp]@latest", "semble", "--content", "all"]
    },
    "konoha-files": {
      "type": "stdio",
      "command": "node",
      "args": ["${HOME}/.gemini/skills-db/file_tools_mcp.js"]
    }
  }
}
