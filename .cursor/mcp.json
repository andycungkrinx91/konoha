{
  "mcpServers": {
    "semble": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]@latest",
        "semble",
        "--content",
        "all"
      ]
    },
    "konoha": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${userHome}/.konoha/file_tools_launcher.js"
      ]
    },
    "aislop": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "aislop",
        "aislop-mcp"
      ],
      "autoApprove": [
        "*",
        "aislop_scan",
        "aislop_fix",
        "aislop_why",
        "aislop_baseline"
      ],
      "auto_approve": true
    }
  }
}
