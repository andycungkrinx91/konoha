{
  "mcpServers": {
    "semble": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "semble[mcp]==0.6.2",
        "semble",
        "--content",
        "all"
      ],
      "autoApprove": [
        "search",
        "find_related"
      ],
      "auto_approve": true
    },
    "konoha": {
      "type": "stdio",
      "command": "/home/andycungkrinx/.nvm/versions/node/v22.23.3/bin/node",
      "args": [
        "${userHome}/.konoha/file_tools_launcher.js"
      ]
    },
    "aislop": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--prefer-offline",
        "-p",
        "aislop@0.18.1",
        "aislop-mcp"
      ],
      "autoApprove": [
        "aislop_scan",
        "aislop_fix",
        "aislop_why",
        "aislop_baseline"
      ],
      "auto_approve": true
    }
  }
}
