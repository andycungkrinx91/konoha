{
  "name": "konoha-mcp",
  "version": "2.1.3",
  "description": "Token-efficient MCP skill server with SQLite FTS5 and specialist agent routing",
  "homepage": "https://github.com/andycungkrinx91/konoha#readme",
  "bugs": "https://github.com/andycungkrinx91/konoha/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andycungkrinx91/konoha.git"
  },
  "type": "commonjs",
  "keywords": [
    "antigravity",
    "cursor",
    "claude-code",
    "mcp",
    "skills",
    "sqlite",
    "fts5",
    "ai-agent",
    "token-optimization"
  ],
  "author": "Andy Setiyawan | The shadow ninja with coffee (https://www.linkedin.com/in/andy-setiyawan-452396170/)",
  "license": "MIT",
  "bin": {
    "konoha": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "apps/web/build/",
    "apps/web/package.json",
    ".agents/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node bin/cli.js ui build",
    "test": "node tests/run_all.js",
    "test:e2e": "pnpm --dir apps/web run test:e2e",
    "test:parallel": "node tests/run_all.js --parallel",
    "test:mcp": "node tests/test_mcp_protocol.js && node tests/test_mcp_e2e.js",
    "test:workflow": "node tests/test_workflow_gates.js && node tests/test_workflow_loop.js",
    "test:jonin": "node tests/test_build_workflows.js && node tests/test_taste_skill_jonin.js",
    "test:docs": "node tests/test_docs_currency.js && node tests/test_documentation_diagrams.js",
    "build:web": "pnpm --dir apps/web run build",
    "sync:skills": "node scripts/sync_skills.js",
    "web": "node bin/cli.js web"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andycungkrinx91/konoha.git"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/vscode": "^1.137.0",
    "gifenc": "^1.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "sharp": ">=0.35.4",
      "adm-zip": ">=0.6.0",
      "devalue": ">=5.9.3",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2"
    }
  }
}
