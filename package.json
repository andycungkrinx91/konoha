{
  "name": "Konoha",
  "version": "2.0.0-beta.4",
  "keywords": [
    "antigravity",
    "cursor",
    "claude-code",
    "mcp",
    "skills",
    "sqlite",
    "fts5",
    "ai-agent",
    "token-optimization"
  ],
  "author": "Andy Setiyawan | The shadow ninja with coffee (https://www.linkedin.com/in/andy-setiyawan-452396170/)",
  "license": "MIT",
  "bin": {
    "konoha": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    ".agents/",
    ".cursor/",
    ".claude/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node tests/run_all.js",
    "test:mcp": "node tests/test_mcp_protocol.js && node tests/test_mcp_e2e.js",
    "test:workflow": "python3 tests/test_workflow_gates.py && python3 tests/test_workflow_loop.py",
    "test:jonin": "python3 tests/test_build_workflows.py && python3 tests/test_taste_skill_jonin.py",
    "test:docs": "python3 tests/test_docs_currency.py && python3 tests/test_documentation_diagrams.py"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andycungkrinx91/konoha"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^4.1.2",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "playwright": "^1.61.1"
  },
  "optionalDependencies": {
    "agent-browser": "^0.36.0"
  }
}
