{
  "name": "Konoha",
  "version": "2.0.0-beta.7",
  "type": "commonjs",
  "keywords": [
    "antigravity",
    "cursor",
    "claude-code",
    "mcp",
    "skills",
    "sqlite",
    "fts5",
    "ai-agent",
    "token-optimization"
  ],
  "author": "Andy Setiyawan | The shadow ninja with coffee (https://www.linkedin.com/in/andy-setiyawan-452396170/)",
  "license": "MIT",
  "bin": {
    "konoha": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "apps/",
    "assets/",
    ".agents/",
    ".cursor/",
    ".claude/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node bin/cli.js ui build",
    "prepare": "node -e \"const fs=require('fs'); if(fs.existsSync('apps/web/package.json') && !fs.existsSync('apps/web/build/handler.js')) { try { require('child_process').execSync('pnpm --dir apps/web run build || npm --prefix apps/web run build', {stdio:'inherit'}); } catch (err) {} }\"",
    "postinstall": "node -e \"const fs=require('fs'); if(fs.existsSync('apps/web/package.json') && !fs.existsSync('apps/web/build/handler.js')) { try { require('child_process').execSync('pnpm --dir apps/web run build || npm --prefix apps/web run build', {stdio:'inherit'}); } catch (err) {} }\"",
    "test": "node tests/run_all.js",
    "test:parallel": "node tests/run_all.js --parallel",
    "test:mcp": "node tests/test_mcp_protocol.js && node tests/test_mcp_e2e.js",
    "test:workflow": "node tests/test_workflow_gates.js && node tests/test_workflow_loop.js",
    "test:jonin": "node tests/test_build_workflows.js && node tests/test_taste_skill_jonin.js",
    "test:docs": "node tests/test_docs_currency.js && node tests/test_documentation_diagrams.js",
    "build:web": "pnpm --dir apps/web run build",
    "sync:skills": "node scripts/sync_skills.js",
    "web": "node bin/cli.js web"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andycungkrinx91/konoha"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@huggingface/transformers": "^4.2.0",
    "@inquirer/prompts": "^8.5.2",
    "better-sqlite3": "^13.0.3",
    "chalk": "^4.1.2",
    "figlet": "^1.11.0",
    "gradient-string": "^3.0.0",
    "playwright": "^1.61.1"
  },
  "optionalDependencies": {
    "agent-browser": "^0.36.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/vscode": "^1.137.0",
    "gifenc": "^1.0.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.4",
      "adm-zip": ">=0.6.0"
    }
  }
}
