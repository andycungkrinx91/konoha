    "type": "git",
    "url": "git+https://github.com/andycungkrinx91/konoha.git"
  },
  "type": "commonjs",
  "keywords": [
    "antigravity",
    "cursor",
    "claude-code",
    "mcp",
    "skills",
    "sqlite",
    "fts5",
    "ai-agent",
    "token-optimization"
