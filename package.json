{
  "name": "konoha-mcp",
  "version": "2.2.22",
  "description": "Autonomous multi-agent MCP orchestration platform powered by LangGraph state machines, 8 specialist ninja agents, SQLite FTS5 skill indexing, and per-turn token governors saving 83–98% context across 8 AI coding clients",
  "homepage": "https://github.com/andycungkrinx91/konoha#readme",
  "bugs": "https://github.com/andycungkrinx91/konoha/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andycungkrinx91/konoha.git"
  },
  "type": "commonjs",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "orchestrator",
    "multi-agent",
    "langgraph",
    "ai-agent",
    "token-optimization",
    "sqlite-fts5",
    "cursor",
    "claude-code",
    "antigravity",
    "codex",
    "opencode",
    "commandcode",
    "pi-dev",
    "omp",
    "developer-tools",
    "sdlc"
  ],
  "author": "Andy Setiyawan | The shadow ninja with coffee (https://www.linkedin.com/in/andy-setiyawan-452396170/)",
  "license": "Apache-2.0",
  "bin": {
    "konoha": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "apps/web/build/",
    "apps/web/package.json",
    "assets/",
    "migrations/",
    "patches/",
    "README.md",
    "LICENSE",
    "!**/anthropic-cybersecurity-skills-assets/**",
    "!**/PLAN.md",
    "!**/PLAN*.md",
    "!**/*-plan.md",
    "!**/*.plan.md",
    "!**/.omp/**",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo",
    "!**/.ruff_cache/**",
    "!**/.pytest_cache/**",
    "!**/.tmp_*/**",
    "!**/*.tmp",
    "!**/*.temp",
    "!**/*.bak",
    "!**/*.swp",
    "!**/.DS_Store",
    "!**/Thumbs.db"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "image-size": ">=2.0.3",
    "globalthis": "npm:@socketregistry/globalthis@1.0.7"
  },
  "bundleDependencies": [
    "cfb",
    "pptxgenjs",
    "xlsx-populate"
  ],
  "scripts": {
    "build": "node bin/cli.js ui build",
    "lint": "node scripts/rtk_exec.js node scripts/lint.js",
    "start": "node bin/cli.js ui start",
    "test": "node scripts/rtk_exec.js node tests/run_all.js",
    "test:e2e": "node scripts/rtk_exec.js pnpm --dir apps/web run test:e2e",
    "test:parallel": "node scripts/rtk_exec.js node tests/run_all.js --parallel",
    "ci:act": "act -W .github/workflows/cross-platform.yml -j checks --matrix os:ubuntu-latest",
    "ci:act:shard": "act -W .github/workflows/cross-platform.yml -j test --matrix os:ubuntu-latest --matrix shard:1",
    "test:sandbox": "node scripts/rtk_exec.js node scripts/sandbox.js",
    "test:mcp": "node scripts/rtk_exec.js node tests/test_mcp_protocol.js && node scripts/rtk_exec.js node tests/test_mcp_e2e.js",
    "test:workflow": "node scripts/rtk_exec.js node tests/test_workflow_gates.js && node scripts/rtk_exec.js node tests/test_workflow_loop.js",
    "test:jonin": "node scripts/rtk_exec.js node tests/test_build_workflows.js && node scripts/rtk_exec.js node tests/test_taste_skill_jonin.js && node scripts/rtk_exec.js node tests/test_jonin_universal_design.js",
    "test:docs": "node scripts/rtk_exec.js node tests/test_docs_currency.js && node scripts/rtk_exec.js node tests/test_documentation_diagrams.js",
    "test:router": "node scripts/rtk_exec.js node tests/test_model_router_protocols.js",
    "check": "pnpm --dir apps/web run check",
    "build:web": "pnpm --dir apps/web run build",
    "sync:skills": "node scripts/sync_skills.js",
    "manual:pdf": "node scripts/build_manual_pdf.js",
    "pack:tgz": "pnpm pack"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@huggingface/transformers": "4.3.2",
    "@langchain/core": "1.3.2",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "cfb": "1.2.2",
    "docx": "^9.14.0",
    "gpt-tokenizer": "4.1.0",
    "hash-wasm": "^4.12.0",
    "manifold-3d": "3.2.1",
    "marked": "18.2.0",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "three": "0.187.0",
    "web-tree-sitter": "0.27.2",
    "xlsx-populate": "^1.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "packageManager": "pnpm@12.16.1"
}
